[gcode_macro LOAD_FILAMENT]
gcode:
    {% if printer.extruder.temperature < 180 %}
        {action_raise_error("Tryska je prilis studena! Zohrej ju na minimalne 180°C.")}
    {% else %}
		# Telegram notifikácia o zavádzaní filamentu
        {action_respond_info("telegram: 📥 Bestia_Voron24: Zavádzam nový filament do trysky.")}

        M83                        # Relatívny extruder
        G1 E50 F300                # Rýchle zavedenie
        G1 E50 F150                # Pomalé dotlačenie
        M82
    {% endif %}

[gcode_macro UNLOAD_FILAMENT]
gcode:
    {% if printer.extruder.temperature < 180 %}
        {action_raise_error("Tryska je prilis studena! Zohrej ju na minimalne 180°C.")}
    {% else %}
		# Telegram notifikácia o vysúvaní filamentu
        {action_respond_info("telegram: 📤 Bestia_Voron24: Vysúvam/vyťahujem filament z trysky.")}

        M83
        G1 E10 F300                # Trochu dotlačiť (vytvorí pekný hrot pred vytiahnutím)
        G1 E-100 F1000             # Rýchlo vytiahnuť
        M82
    {% endif %}
