[gcode_macro M600]
gcode:
    # 1. Pozastavenie tlače a odskok Z
    PAUSE
    G91
    G1 E-1.5 F2700        # Rýchla retrakcia, aby netiekol filament
    G1 Z+10 F3000         # Mierny odskok nahor
    G90
    
    # 2. Využitie tvojho existujúceho makra na parkovanie vpredu
    PARK_FRONT
    
    # 3. Automatické vytiahnutie filamentu
    UNLOAD_FILAMENT
    
    # 4. Správa pre teba v Mainsaili
    {action_respond_info("Tlač pozastavená: Vymeň filament, zaveď nový cez LOAD_FILAMENT a stlač RESUME")}
