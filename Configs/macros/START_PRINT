[gcode_macro START_PRINT]
gcode:
    {% set BED_TEMP = params.BED|default(60)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER|default(200)|float %}

    # Notifikácia na Telegram, že sa začína príprava
    {action_respond_info("telegram: 🚀 Bestia_Voron24 spúšťa prípravu na tlač! Podložka: %3.1f°C, Extrúder: %3.1f°C" % (BED_TEMP, EXTRUDER_TEMP))}

    # 1. Zapnutie Nevermore filtra (80% výkon)
    SET_FAN_SPEED FAN=nevermore SPEED=0.8

    # 2. Predhriatie bez čakania
    M140 S{BED_TEMP}
    M104 S150

    # 3. Spustenie kompletnej kalibrácie (využije tvoje G32 makro: G28 -> QGL -> G28 Z -> Park stred)
    G32

    # 4. Čakanie na finálnu teplotu podložky
    M190 S{BED_TEMP}

    # 5. Vygenerovanie bed mesh na stabilne nahriatej podložke
    BED_MESH_CALIBRATE PROFILE=default
    
    # 6. Nahriatie trysky na pracovnú teplotu
    M109 S{EXTRUDER_TEMP}

    # 7. Čistiaca čiara (Purge line)
    G90
    G1 Z2.0 F3000
    G1 X5 Y5 Z0.3 F5000.0
    G1 X200.0 Y5 Z0.3 F1500.0 E15
    G1 X200.0 Y5.4 Z0.3 F5000.0
    G1 X5 Y5.4 Z0.3 F1500.0 E30
    G92 E0
    G1 Z2.0 F3000
