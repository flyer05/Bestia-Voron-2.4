[gcode_macro PAUSE]
rename_existing: BASE_PAUSE
gcode:
    # Telegram notifikácia o pozastavení tlače
    {action_respond_info("telegram: ⏸️ Tlač na Bestia_Voron24 bola pozastavená.")}

    {% set z = params.Z|default(10)|float %}
    SAVE_GCODE_STATE NAME=PAUSE_state
    BASE_PAUSE
    G91
    G1 E-1.5 F2700
    G1 Z{z} F3000
    G90
    PARK_FRONT

[gcode_macro RESUME]
rename_existing: BASE_RESUME
gcode:
    # Telegram notifikácia o pokračovaní v tlači
    {action_respond_info("telegram: ▶️ Tlač na Bestia_Voron24 pokračuje.")}

    G91
    G1 E1.5 F2700
    RESTORE_GCODE_STATE NAME=PAUSE_state MOVE=1
    BASE_RESUME
