#####################################################################
#      Z Stepper Settings - SLOT 5, 6, 7, 8 (24V TMC5160)
#####################################################################

## Z0 Stepper - Front Left (Slot 5)
[stepper_z]
step_pin: PB3
dir_pin: PD2
enable_pin: !PA15
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32
endstop_pin: probe:z_virtual_endstop
position_max: 300
position_min: -5
homing_speed: 15 # Pri 5160 môžeš ísť trochu svižnejšie

[tmc5160 stepper_z]
cs_pin: PD5
spi_software_sclk_pin: PA5
spi_software_mosi_pin: PA7
spi_software_miso_pin: PA6
interpolate: True
run_current: 0.8
sense_resistor: 0.075
stealthchop_threshold: 0

## Z1 Stepper - Rear Left (Slot 6)
[stepper_z1]
step_pin: PA1
dir_pin: !PA3
enable_pin: !PA4
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc5160 stepper_z1]
cs_pin: PA2
spi_software_sclk_pin: PA5
spi_software_mosi_pin: PA7
spi_software_miso_pin: PA6
interpolate: True
run_current: 0.8
sense_resistor: 0.075
stealthchop_threshold: 0

## Z2 Stepper - Rear Right (Slot 7)
[stepper_z2]
step_pin: PD4
dir_pin: PD3
enable_pin: !PD5
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc5160 stepper_z2]
cs_pin: PD6
spi_software_sclk_pin: PA5
spi_software_mosi_pin: PA7
spi_software_miso_pin: PA6
interpolate: True
run_current: 0.8
sense_resistor: 0.075
stealthchop_threshold: 0

## Z3 Stepper - Front Right (Slot 8)
[stepper_z3]
step_pin: PD7
dir_pin: !PD6
enable_pin: !PB3
rotation_distance: 40
gear_ratio: 80:16
microsteps: 32

[tmc5160 stepper_z3]
cs_pin: PB4
spi_software_sclk_pin: PA5
spi_software_mosi_pin: PA7
spi_software_miso_pin: PA6
interpolate: True
